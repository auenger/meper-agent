# Deploy environment variables — copy to .env and fill in values
# NEVER commit the real .env file to version control.

# Application
APP_NAME=Agent Flow
APP_ENV=production
DEBUG=false

# MongoDB
MONGODB_URI=mongodb://agentflow:changeme@mongodb:27017/agent_flow?authSource=admin
MONGODB_DB_NAME=agent_flow
MONGO_ROOT_USER=agentflow
MONGO_ROOT_PASSWORD=changeme

# Redis
REDIS_URL=redis://redis:6379/0

# Qdrant (vector store for vector KBs)
# In Docker, use the service name "qdrant" — NOT localhost (localhost inside
# the container points to the container itself and cannot reach the qdrant service).
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
# Collection name for vector KB chunks (shared by all vector KBs, isolated by kb_id).
KB_QDRANT_COLLECTION=kb_chunks

# ── Vector KB: embedding (REQUIRED to use vector KBs) ──────────────────
# Without these, vector KB document indexing fails at the embedding step.
KB_EMBEDDING_BASE_URL=http://119.119.118.187:11434/v1
KB_EMBEDDING_MODEL=bge-m3
# API key for the embedding provider. Leave empty for local Ollama (no auth).
KB_EMBEDDING_API_KEY=

# ── Vector KB: reranker (OPTIONAL — skip rerank if unset) ──────────────
# When unset, retrieval skips the rerank step and returns RRF-fused results.
KB_RERANKER_BASE_URL=
KB_RERANKER_MODEL=
KB_RERANKER_API_KEY=

# ── Model encryption key (REQUIRED for custom tools with credentials) ──
# Fernet key for encrypting sensitive custom-tool params at rest.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty ONLY in dev (credentials stored unencrypted); MUST set in production.
MODEL_ENCRYPTION_KEY=

# JWT
JWT_SECRET_KEY=CHANGE-ME-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# CORS
CORS_ORIGINS=http://localhost,http://localhost:5173

# Logging
LOG_LEVEL=INFO
LOG_JSON_FORMAT=true

# Admin user (for initial setup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
ADMIN_EMAIL=admin@example.com

# ── Data directories ──────────────────────────────────────────────────
# Host-side ABSOLUTE paths for persistent data (used by Docker bind mounts).
# These are the paths on the HOST machine where data is stored.
# IMPORTANT: Use absolute paths! Relative paths may not resolve correctly
# when the backend spawns sandbox containers via Docker socket.
# Default: ${HOME}/.agent-flow/... (separates data from project code).
# ${HOME} is resolved by docker-compose when starting services.
WORKSPACES_HOST_DIR=${HOME}/.agent-flow/data/workspaces
SKILLS_HOST_DIR=${HOME}/.agent-flow/data/skills
# 用户资产根（个人技能 {uid}/skills/，持久——不参与 workspace 清理）
HOMES_HOST_DIR=${HOME}/.agent-flow/data/homes
MONGODB_DATA_DIR=${HOME}/.agent-flow/data/mongodb
REDIS_DATA_DIR=${HOME}/.agent-flow/data/redis
QDRANT_DATA_DIR=${HOME}/.agent-flow/data/qdrant
KB_HOST_DIR=${HOME}/.agent-flow/data/knowledge_bases

# Container-internal paths (where host dirs are mounted inside backend container).
# Backend code uses these to access files. Usually don't need to change.
WORKSPACES_CONTAINER_DIR=/data/workspaces
SKILLS_CONTAINER_DIR=/data/skills
HOMES_CONTAINER_DIR=/data/homes
KB_CONTAINER_DIR=/data/knowledge_bases

WORKSPACE_MAX_BYTES=524288000

# Sandbox (bash tool isolation)
SANDBOX_ENABLED=true
SANDBOX_IMAGE=agent-sandbox:latest
SANDBOX_MEM_LIMIT=512m
SANDBOX_CPU_QUOTA=100000
SANDBOX_TIMEOUT=120
SANDBOX_MAX_OUTPUT_BYTES=51200
# Network mode: "none" (secure), "bridge" (internet access), "host" (least isolation)
SANDBOX_NETWORK_MODE=bridge
# Container-internal mount points (inside the sandbox container).
# These define where workspace/skill dirs appear inside the sandbox.
SANDBOX_CONTAINER_WORKSPACE_DIR=/workspace
SANDBOX_CONTAINER_SKILLS_DIR=/data/skills

# ── Docker images ──────────────────────────────────────────────────
# For production deployment with ACR (Alibaba Cloud Container Registry):
# BACKEND_IMAGE=crpi-xxx.cn-hangzhou.personal.cr.aliyuncs.com/agent-flow/agent-flow-backend:latest
# CADDY_IMAGE=crpi-xxx.cn-hangzhou.personal.cr.aliyuncs.com/agent-flow/agent-flow-caddy:latest
# SANDBOX_IMAGE=crpi-xxx.cn-hangzhou.personal.cr.aliyuncs.com/agent-flow/agent-flow-sandbox:latest
#
# For local development, leave as default (will build from Dockerfile)
# BACKEND_IMAGE=deploy-backend
# CADDY_IMAGE=deploy-caddy
# SANDBOX_IMAGE=agent-sandbox:latest
