# Application
APP_NAME=Agent Flow
APP_ENV=development
DEBUG=true

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=agent_flow

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant (vector store for vector-type knowledge bases; requires >= 1.10)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# JWT
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_JSON_FORMAT=false

# LangSmith tracing (optional — leave empty to disable)
# Get your API key at https://smith.langchain.com/settings
# Free Developer plan: 5,000 traces/month
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-flow

# Session token budget (cumulative tokens per session, 0 = use this default)
DEFAULT_SESSION_MAX_TOKENS=200000

# Model API Key encryption (Base64-encoded 32-byte AES-256 key)
# Generate: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
MODEL_ENCRYPTION_KEY=

# ── Workspace ─────────────────────────────────────────────────────────
# Host-side root directory for per-session workspaces (input/, output/, tmp/).
# Layout: {WORKSPACES_HOST_DIR}/{user_id}/{session_id}/
# In Docker, WORKSPACES_CONTAINER_DIR is injected by docker-compose (container-internal path).
WORKSPACES_HOST_DIR=~/.agent-flow/workspaces
WORKSPACE_MAX_BYTES=524288000

# ── Skills ────────────────────────────────────────────────────────────
# Host-side root directory where Skill files are stored.
SKILLS_HOST_DIR=~/.agent-flow/skills

# ── Sandbox (Docker-based bash execution) ─────────────────────────────
# Set SANDBOX_ENABLED=true to run bash commands inside Docker containers.
# When false (default), bash runs via subprocess (suitable for local dev).
SANDBOX_ENABLED=false
SANDBOX_IMAGE=agent-sandbox:latest
SANDBOX_MEM_LIMIT=512m
SANDBOX_CPU_QUOTA=100000
SANDBOX_TIMEOUT=120
SANDBOX_MAX_OUTPUT_BYTES=51200

# Network mode for sandbox containers.
# "none"   = no network access (most secure, default)
# "bridge" = standard Docker bridge network (allows outbound internet)
# "host"   = use host network stack (least isolation)
SANDBOX_NETWORK_MODE=none

# Container-internal mount points (usually don't need to change).
SANDBOX_CONTAINER_WORKSPACE_DIR=/workspace
SANDBOX_CONTAINER_SKILLS_DIR=/data/skills
USE_HARNESS_ENGINE=True

# ── Vector Knowledge Base (RAG) ──────────────────────────────────────
# Embedding model (REQUIRED for vector KB). base_url + model 必填；api_key 对
# 本地 Ollama / LM Studio 等可留空（云端 OpenAI/DeepSeek/通义等必填）。
#
# 本地 Ollama 示例（先 ollama pull bge-m3）：
#   KB_EMBEDDING_BASE_URL=http://localhost:11434/v1
#   KB_EMBEDDING_MODEL=bge-m3
#   KB_EMBEDDING_API_KEY=
#
# 云端示例（OpenAI 兼容）：
#   KB_EMBEDDING_BASE_URL=https://api.openai.com/v1
#   KB_EMBEDDING_MODEL=text-embedding-3-small
#   KB_EMBEDDING_API_KEY=sk-xxx
KB_EMBEDDING_BASE_URL=https://api.openai.com/v1
KB_EMBEDDING_MODEL=text-embedding-3-small
KB_EMBEDDING_API_KEY=

# Reranker model (OPTIONAL — retrieval degrades gracefully when unset).
# Uses SiliconFlow/Jina/Cohere-compatible /v1/rerank endpoint. Ollama does
# not host a /v1/rerank endpoint, so for local-only setups leave this empty.
KB_RERANKER_BASE_URL=
KB_RERANKER_MODEL=
KB_RERANKER_API_KEY=

# Qdrant collection name (single shared collection; kb_id payload filters KBs).
KB_QDRANT_COLLECTION=kb_chunks

# LangGraph recursion limit — the max number of supersteps per graph run.
# Each REACT iteration (LLM call + tool execution) consumes ~2 supersteps,
# so 75 ≈ 37 tool-call rounds. Raise this for agents that legitimately
# need many steps (multi-file exploration, deep research, etc.).
AGENT_RECURSION_LIMIT=200